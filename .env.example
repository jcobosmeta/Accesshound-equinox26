# Copy to server/.env (loaded automatically; variables set in your shell take priority).
# With no key, the agent runs in replay mode. Check your setup with: npm run check-agent

# Anthropic API key, or a LiteLLM proxy key when ANTHROPIC_BASE_URL points at the proxy.
ANTHROPIC_API_KEY=
# Leave empty for Anthropic's API. For a LiteLLM proxy, its URL, e.g. https://litellm.example.com
ANTHROPIC_BASE_URL=

# live | replay (default: live when a key is set)
AGENT_MODE=
# On a proxy, use the proxy's name for the model if it differs.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# on | off. Server-side fallbacks retry a declined request on another model; some proxies reject them.
AGENT_FALLBACKS=on
PORT=8787
